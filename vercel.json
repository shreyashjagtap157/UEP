{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "vite",
      "routes": [
        {
          "src": "/((?!assets/|.*\\.[^/]+$).*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        }
      ]
    },
    "backend": {
      "root": "apps/platform-server",
      "runtime": "container",
      "entrypoint": "Dockerfile",
      "routes": [
        {
          "src": "/api/_health",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/actuator/health"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/_health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
