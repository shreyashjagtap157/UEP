{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "npm ci --ignore-scripts",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist",
      "routes": [
        {
          "src": "/((?!assets/|.*\\.[^/]+$).*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        }
      ]
    },
    "backend": {
      "root": "apps/platform-server",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
