MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
NOTIFICATION_EMAIL_FROM=no-reply@localhost
NOTIFICATION_OUTBOX_POLL_MS=1000
NOTIFICATION_EMAIL_POLL_MS=2000
ANNOUNCEMENT_PUBLISH_POLL_MS=1000
ANNOUNCEMENT_EXPIRY_POLL_MS=60000
